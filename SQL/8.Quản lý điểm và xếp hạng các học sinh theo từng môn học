CREATE PROCEDURE sp_XemBangDiemVaXepLoai
    @MaMon CHAR(5)
AS
BEGIN
    SELECT 
        h.HoTen, 
        d.DiemSo,
        CASE 
            WHEN d.DiemSo >= 8.0 THEN N'Giỏi'
            WHEN d.DiemSo >= 6.5 THEN N'Khá'
            WHEN d.DiemSo >= 5.0 THEN N'Trung Bình'
            ELSE N'Yếu'
        END AS XepLoai
    FROM BangDiem d
    JOIN HocSinh h ON d.MaHS = h.MaHS
    WHERE d.MaMon = @MaMon;
END;
GO
